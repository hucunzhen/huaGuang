<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>HuaGuang.Monitor.Service</RootNamespace>
    <OutputType>Exe</OutputType>
    <ApplicationIcon>..\HuaGuang.Monitor\Resources\AppIcon\appicon.ico</ApplicationIcon>
    <AssemblyName>HuaGuang.Monitor.Service</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HuaGuang.Monitor.Runtime\HuaGuang.Monitor.Runtime.csproj" />
    <ProjectReference Include="..\HuaGuang.Monitor.Core\HuaGuang.Monitor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\config\lines\*.xlsx"
             Exclude="..\..\config\lines\~$*;..\..\config\lines\*.new.xlsx"
             Link="lines\%(Filename)%(Extension)"
             CopyToOutputDirectory="Always"
             CopyToPublishDirectory="Always" />
  </ItemGroup>

</Project>
