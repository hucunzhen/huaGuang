<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HuaGuang.Monitor.ViewModels"
             x:Class="HuaGuang.Monitor.Views.TagEditPage"
             x:DataType="vm:TagEditViewModel"
             Title="{Binding Title}"
             SafeAreaEdges="All"
             BackgroundColor="#0B1522">

    <ScrollView>
        <VerticalStackLayout Padding="16,6,16,24" Spacing="12">
            <Label Text="名称" TextColor="#8AA0B5" FontSize="12" />
            <Entry Text="{Binding Name}" Placeholder="胶辊型号 / 产品货号 / 温度 / 门幅" />
            <Label Text="单位" TextColor="#8AA0B5" FontSize="12" />
            <Entry Text="{Binding Unit}" Placeholder="℃ / mm / 留空" />
            <HorizontalStackLayout Spacing="10">
                <CheckBox IsChecked="{Binding Enabled}" Color="#2EC4B6" VerticalOptions="Center" />
                <Label Text="启用" TextColor="White" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label Text="显示分组（监控页）" TextColor="#8AA0B5" FontSize="12" />
            <Picker ItemsSource="{Binding DisplayCategoryOptions}" SelectedItem="{Binding SelectedDisplayCategoryOption}" />
            <Label Text="对应产线 Excel「点表·显示分组」。选「自动推断」则按类型/名称归类。"
                   TextColor="#8AA0B5" FontSize="12" LineBreakMode="WordWrap" />

            <Label Text="MQTT 字段名" TextColor="#8AA0B5" FontSize="12" />
            <Entry Text="{Binding MqttField}" Placeholder="如 run_status、speed；留空用映射表或点位名称" />
            <Label Text="对应产线 Excel「字段映射」表的 id 列；平铺 JSON 报文根级字段名。"
                   TextColor="#8AA0B5" FontSize="12" LineBreakMode="WordWrap" />

            <Label Text="数据来源" TextColor="#8AA0B5" FontSize="12" />
            <Picker ItemsSource="{Binding SourceTypes}" SelectedItem="{Binding SelectedSourceType}" />
            <Label Text="手动输入：不参与 PLC 读取，值随 MQTT 一起发布（如胶辊型号、产品货号、门幅）。"
                   TextColor="#8AA0B5" FontSize="12" LineBreakMode="WordWrap"
                   IsVisible="{Binding IsManualSource}" />

            <Label Text="手动值" TextColor="#8AA0B5" FontSize="12" IsVisible="{Binding IsManualSource}" />
            <Entry Text="{Binding ManualValue}" Placeholder="例如：A型 / 1200 / 0.12"
                   IsVisible="{Binding IsManualSource}" />

            <Label Text="数据类型" TextColor="#8AA0B5" FontSize="12"
                   IsVisible="{Binding IsManualSource}" />
            <Picker ItemsSource="{Binding DataTypes}" SelectedItem="{Binding DataTypeName}"
                    IsVisible="{Binding IsManualSource}" />

            <Label Text="信捷地址（XD5E）" TextColor="#8AA0B5" FontSize="12" IsVisible="{Binding IsPlcSource}" />
            <Entry Text="{Binding XinjeAddress}" Placeholder="D100 / M0 / X20 / Y0" IsVisible="{Binding IsPlcSource}" />
            <Label Text="{Binding ResolvedHint}" TextColor="#2EC4B6" FontSize="12" LineBreakMode="WordWrap"
                   IsVisible="{Binding IsPlcSource}" />
            <Label Text="数据类型（M/X/Y 会自动按位读取）" TextColor="#8AA0B5" FontSize="12" IsVisible="{Binding IsPlcSource}" />
            <Picker ItemsSource="{Binding PlcDataTypes}" SelectedItem="{Binding DataTypeName}" IsVisible="{Binding IsPlcSource}" />
            <Label Text="字节序（32 位）" TextColor="#8AA0B5" FontSize="12" IsVisible="{Binding IsPlcSource}" />
            <Picker ItemsSource="{Binding ByteOrders}" SelectedItem="{Binding ByteOrderName}" IsVisible="{Binding IsPlcSource}" />
            <Label Text="比例 Scale" TextColor="#8AA0B5" FontSize="12" IsVisible="{Binding IsPlcSource}" />
            <Entry Text="{Binding Scale}" Keyboard="Numeric" IsVisible="{Binding IsPlcSource}" />
            <Label Text="偏移 Offset" TextColor="#8AA0B5" FontSize="12" IsVisible="{Binding IsPlcSource}" />
            <Entry Text="{Binding Offset}" Keyboard="Numeric" IsVisible="{Binding IsPlcSource}" />

            <Label Text="显示精度（小数位）" TextColor="#8AA0B5" FontSize="12" IsVisible="{Binding ShowPrecision}" />
            <Entry Text="{Binding DisplayPrecision}" Keyboard="Numeric" Placeholder="留空=全局默认"
                   IsVisible="{Binding ShowPrecision}" />
            <Label Text="0–4。留空则使用「设置」里的全局默认精度；影响监控显示与 MQTT 发布。"
                   TextColor="#8AA0B5" FontSize="12" LineBreakMode="WordWrap"
                   IsVisible="{Binding ShowPrecision}" />

            <Button Text="保存点位" Command="{Binding SaveCommand}" />
            <Label Text="{Binding StatusMessage}" TextColor="#FF6B6B" FontSize="13" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
