<?xml version="1.0" encoding="utf-8" ?>
<views:MonitorPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:HuaGuang.Monitor.Views"
             xmlns:vm="clr-namespace:HuaGuang.Monitor.ViewModels"
             xmlns:diag="clr-namespace:HuaGuang.Monitor.Diagnostics"
             xmlns:logging="clr-namespace:HuaGuang.Monitor.Services.Logging"
             x:Class="HuaGuang.Monitor.Views.DiagnosticsPage"
             x:Name="ThisPage"
             x:DataType="vm:DiagnosticsViewModel"
             Shell.NavBarIsVisible="False"
             SafeAreaEdges="All"
             BackgroundColor="#0B1522">

    <Grid RowDefinitions="Auto,Auto,*"
          VerticalOptions="Fill"
          Padding="{Binding Source={x:Reference ThisPage}, Path=IsCompactLayout, Converter={StaticResource PagePaddingConverter}}"
          RowSpacing="{Binding Source={x:Reference ThisPage}, Path=IsCompactLayout, Converter={StaticResource RowSpacingConverter}}">

        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label Text="诊断"
                   TextColor="White"
                   FontAttributes="Bold"
                   FontSize="{Binding Source={x:Reference ThisPage}, Path=TitleFontSize}" />
            <Label Text="{Binding AppVersionText}"
                   TextColor="#6E8499"
                   FontSize="{Binding Source={x:Reference ThisPage}, Path=CaptionFontSize}" />
            <Label Text="{Binding StatusMessage}"
                   TextColor="#8AA0B5"
                   LineBreakMode="WordWrap"
                   FontSize="{Binding Source={x:Reference ThisPage}, Path=BodyFontSize}" />
        </VerticalStackLayout>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,*,*"
              ColumnSpacing="6"
              Margin="0,6,0,4">
            <Button Grid.Column="0"
                    Text="概览"
                    Command="{Binding SelectDiagnosticsTabCommand}"
                    CommandParameter="{x:Static vm:DiagnosticsViewModel.TabOverview}"
                    Padding="8,8"
                    FontSize="{Binding Source={x:Reference ThisPage}, Path=ButtonFontSize}"
                    BackgroundColor="#1F3A52"
                    TextColor="#C9D6E2">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding SelectedDiagnosticsTab}"
                                 Value="{x:Static vm:DiagnosticsViewModel.TabOverview}">
                        <Setter Property="BackgroundColor" Value="#2EC4B6" />
                        <Setter Property="TextColor" Value="#0B1522" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="1"
                    Text="运行日志"
                    Command="{Binding SelectDiagnosticsTabCommand}"
                    CommandParameter="{x:Static vm:DiagnosticsViewModel.TabLogs}"
                    Padding="8,8"
                    FontSize="{Binding Source={x:Reference ThisPage}, Path=ButtonFontSize}"
                    BackgroundColor="#1F3A52"
                    TextColor="#C9D6E2">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding SelectedDiagnosticsTab}"
                                 Value="{x:Static vm:DiagnosticsViewModel.TabLogs}">
                        <Setter Property="BackgroundColor" Value="#2EC4B6" />
                        <Setter Property="TextColor" Value="#0B1522" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="2"
                    Text="软件自检"
                    Command="{Binding SelectDiagnosticsTabCommand}"
                    CommandParameter="{x:Static vm:DiagnosticsViewModel.TabSelfCheck}"
                    Padding="8,8"
                    FontSize="{Binding Source={x:Reference ThisPage}, Path=ButtonFontSize}"
                    BackgroundColor="#1F3A52"
                    TextColor="#C9D6E2">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding SelectedDiagnosticsTab}"
                                 Value="{x:Static vm:DiagnosticsViewModel.TabSelfCheck}">
                        <Setter Property="BackgroundColor" Value="#2EC4B6" />
                        <Setter Property="TextColor" Value="#0B1522" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>

        <!-- 概览 -->
        <ScrollView Grid.Row="2"
                    IsVisible="{Binding IsOverviewTab}"
                    VerticalScrollBarVisibility="Default">
            <VerticalStackLayout Spacing="8" Padding="0,0,0,12">
                <Border Stroke="#1F3A52" StrokeThickness="1" BackgroundColor="#152536" Padding="10,8">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="后台服务状态"
                               TextColor="#2EC4B6"
                               FontAttributes="Bold"
                               FontSize="{Binding Source={x:Reference ThisPage}, Path=BodyFontSize}" />
                        <Label Text="{Binding ServiceStatusText}"
                               TextColor="#C9D6E2"
                               LineBreakMode="WordWrap"
                               FontSize="{Binding Source={x:Reference ThisPage}, Path=CaptionFontSize}" />
                    </VerticalStackLayout>
                </Border>

                <Border Stroke="#1F3A52" StrokeThickness="1" BackgroundColor="#0F1A26" Padding="10,8">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="日志与数据路径"
                               TextColor="#2EC4B6"
                               FontAttributes="Bold"
                               FontSize="{Binding Source={x:Reference ThisPage}, Path=CaptionFontSize}" />
                        <Label Text="{Binding LogPathsDisplayText}"
                               TextColor="#8AA0B5"
                               LineBreakMode="WordWrap"
                               FontSize="{Binding Source={x:Reference ThisPage}, Path=SmallFontSize}" />
                    </VerticalStackLayout>
                </Border>

                <Button Text="打包发送日志"
                        Command="{Binding ExportLogBundleCommand}"
                        IsEnabled="{Binding IsExportingLogBundle, Converter={StaticResource InverseBoolConverter}}"
                        Padding="12,8"
                        FontSize="{Binding Source={x:Reference ThisPage}, Path=ButtonFontSize}" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- 运行日志 -->
        <Grid Grid.Row="2"
              IsVisible="{Binding IsLogsTab}"
              RowDefinitions="Auto,*"
              RowSpacing="6">
            <FlexLayout Grid.Row="0"
                        Wrap="Wrap"
                        Direction="Row"
                        AlignItems="Center"
                        JustifyContent="Start">
                <Label Text="{Binding LogSummaryText}"
                       TextColor="#8AA0B5"
                       Margin="0,0,12,4"
                       FontSize="{Binding Source={x:Reference ThisPage}, Path=CaptionFontSize}" />
                <Switch IsToggled="{Binding ShowAllLogCategories}"
                        OnColor="#2EC4B6"
                        Margin="0,0,8,4" />
                <Label Text="全部类别"
                       TextColor="#8AA0B5"
                       Margin="0,0,8,4"
                       VerticalOptions="Center"
                       FontSize="{Binding Source={x:Reference ThisPage}, Path=CaptionFontSize}" />
                <Button Text="刷新"
                        Command="{Binding RefreshLogsCommand}"
                        Padding="10,6"
                        Margin="0,0,6,4"
                        FontSize="{Binding Source={x:Reference ThisPage}, Path=ButtonFontSize}" />
                <Button Text="清空"
                        Command="{Binding ClearLogsCommand}"
                        Padding="10,6"
                        Margin="0,0,6,4"
                        BackgroundColor="#1F3A52"
                        FontSize="{Binding Source={x:Reference ThisPage}, Path=ButtonFontSize}" />
                <Button Text="日志目录"
                        Command="{Binding OpenLogFolderCommand}"
                        Padding="10,6"
                        Margin="0,0,6,4"
                        BackgroundColor="#1F3A52"
                        FontSize="{Binding Source={x:Reference ThisPage}, Path=ButtonFontSize}" />
            </FlexLayout>

            <Border Grid.Row="1"
                    Stroke="#1F3A52"
                    StrokeThickness="1"
                    BackgroundColor="#101C28"
                    Padding="4,2"
                    VerticalOptions="Fill">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <CollectionView ItemsSource="{Binding LogEntries}"
                                SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Label Text="暂无运行日志。启动采集或订阅后，后台服务日志将显示在此。"
                               TextColor="#6E8499"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Margin="12"
                               LineBreakMode="WordWrap"
                               FontSize="{Binding Source={x:Reference ThisPage}, Path=BodyFontSize}" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="logging:RuntimeLogEntry">
                            <VerticalStackLayout Spacing="2"
                                                 Padding="6,4">
                                <FlexLayout Wrap="Wrap"
                                            Direction="Row"
                                            AlignItems="Start"
                                            JustifyContent="Start">
                                    <Label Text="{Binding TimeText}"
                                           TextColor="#6E8499"
                                           Margin="0,0,8,0"
                                           FontSize="{Binding Source={x:Reference ThisPage}, Path=SmallFontSize}" />
                                    <Label Text="{Binding LevelText}"
                                           TextColor="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"
                                           FontAttributes="Bold"
                                           Margin="0,0,8,0"
                                           FontSize="{Binding Source={x:Reference ThisPage}, Path=SmallFontSize}" />
                                    <Label Text="{Binding Category}"
                                           TextColor="#8AA0B5"
                                           LineBreakMode="WordWrap"
                                           FontSize="{Binding Source={x:Reference ThisPage}, Path=SmallFontSize}" />
                                </FlexLayout>
                                <Label Text="{Binding Message}"
                                       TextColor="#C9D6E2"
                                       LineBreakMode="WordWrap"
                                       FontSize="{Binding Source={x:Reference ThisPage}, Path=CaptionFontSize}" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>
        </Grid>

        <!-- 软件自检 -->
        <ScrollView Grid.Row="2"
                    IsVisible="{Binding IsSelfCheckTab}"
                    VerticalScrollBarVisibility="Default">
            <VerticalStackLayout Spacing="8" Padding="0,0,0,12">
                <Label Text="{Binding SummaryText}"
                       TextColor="#2EC4B6"
                       FontAttributes="Bold"
                       FontSize="{Binding Source={x:Reference ThisPage}, Path=SubtitleFontSize}" />
                <FlexLayout Wrap="Wrap"
                            Direction="Row"
                            JustifyContent="Start"
                            AlignItems="Center">
                    <Button Text="核心测试"
                            Command="{Binding RunCoreTestsCommand}"
                            Padding="10,6"
                            Margin="0,0,6,6"
                            FontSize="{Binding Source={x:Reference ThisPage}, Path=ButtonFontSize}" />
                    <Button Text="全部测试"
                            Command="{Binding RunAllTestsCommand}"
                            Padding="10,6"
                            Margin="0,0,6,6"
                            FontSize="{Binding Source={x:Reference ThisPage}, Path=ButtonFontSize}" />
                    <Button Text="压力测试"
                            Command="{Binding RunStressTestCommand}"
                            Padding="10,6"
                            Margin="0,0,6,6"
                            BackgroundColor="#1F3A52"
                            FontSize="{Binding Source={x:Reference ThisPage}, Path=ButtonFontSize}" />
                    <ActivityIndicator IsRunning="{Binding IsRunning}"
                                       Color="#2EC4B6"
                                       HeightRequest="24"
                                       WidthRequest="24" />
                </FlexLayout>
                <CollectionView ItemsSource="{Binding Results}"
                                SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="4" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="diag:DiagnosticResult">
                            <Border Stroke="#1F3A52"
                                    StrokeThickness="1"
                                    BackgroundColor="#152536"
                                    Padding="8,6">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Label Text="{Binding Name}"
                                       TextColor="White"
                                       FontSize="{Binding Source={x:Reference ThisPage}, Path=CaptionFontSize}" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</views:MonitorPageBase>
