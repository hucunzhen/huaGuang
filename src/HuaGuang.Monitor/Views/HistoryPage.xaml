<?xml version="1.0" encoding="utf-8" ?>
<views:MonitorPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:HuaGuang.Monitor.Views"
             xmlns:vm="clr-namespace:HuaGuang.Monitor.ViewModels"
             xmlns:services="clr-namespace:HuaGuang.Monitor.Services"
             xmlns:controls="clr-namespace:HuaGuang.Monitor.Controls"
             x:Class="HuaGuang.Monitor.Views.HistoryPage"
             x:Name="ThisPage"
             x:DataType="vm:HistoryViewModel"
             Shell.NavBarIsVisible="False"
             SafeAreaEdges="All"
             BackgroundColor="#0B1522">

    <Grid RowDefinitions="Auto,Auto,*,Auto"
          Padding="{Binding Source={x:Reference ThisPage}, Path=IsCompactLayout, Converter={StaticResource PagePaddingConverter}}"
          RowSpacing="8">
        <VerticalStackLayout Spacing="2">
            <Label Text="历史数据" TextColor="White" FontAttributes="Bold"
                   FontSize="{Binding Source={x:Reference ThisPage}, Path=TitleFontSize}" />
            <Label Text="{Binding SummaryText}" TextColor="#8AA0B5" LineBreakMode="WordWrap"
                   FontSize="{Binding Source={x:Reference ThisPage}, Path=CaptionFontSize}" />
            <Label Text="先点「刷新」加载数据；可选快捷范围或「自定义时间」按起止时间查找；修改筛选后需再次刷新。表头完整显示，列宽可拖动表头右侧边缘调整，列较多时可左右滑动查看。"
                   TextColor="#6E8499"
                   FontSize="{Binding Source={x:Reference ThisPage}, Path=CaptionFontSize}" />
        </VerticalStackLayout>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
            <VerticalStackLayout Spacing="2">
                <Label Text="时间范围" TextColor="#8AA0B5" FontSize="12" />
                <Picker ItemsSource="{Binding RangeOptions}" SelectedItem="{Binding SelectedRange}"
                        FontSize="{Binding Source={x:Reference ThisPage}, Path=BodyFontSize}" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" Spacing="2">
                <Label Text="设备" TextColor="#8AA0B5" FontSize="12" />
                <Picker ItemsSource="{Binding DeviceOptions}" SelectedItem="{Binding SelectedDevice}"
                        FontSize="{Binding Source={x:Reference ThisPage}, Path=BodyFontSize}" />
            </VerticalStackLayout>

            <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,*" ColumnSpacing="8"
                  IsVisible="{Binding ShowCustomTimeFilters}">
                <VerticalStackLayout Spacing="4">
                    <HorizontalStackLayout Spacing="8">
                        <CheckBox IsChecked="{Binding UseCustomStart}" Color="#2EC4B6" VerticalOptions="Center" />
                        <Label Text="开始时间" TextColor="#8AA0B5" VerticalOptions="Center"
                               FontSize="{Binding Source={x:Reference ThisPage}, Path=CaptionFontSize}" />
                    </HorizontalStackLayout>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                        <DatePicker Date="{Binding CustomStartDate}"
                                    IsEnabled="{Binding UseCustomStart}"
                                    FontSize="{Binding Source={x:Reference ThisPage}, Path=BodyFontSize}" />
                        <TimePicker Grid.Column="1"
                                    Time="{Binding CustomStartTime}"
                                    IsEnabled="{Binding UseCustomStart}"
                                    FontSize="{Binding Source={x:Reference ThisPage}, Path=BodyFontSize}" />
                    </Grid>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <HorizontalStackLayout Spacing="8">
                        <CheckBox IsChecked="{Binding UseCustomEnd}" Color="#2EC4B6" VerticalOptions="Center" />
                        <Label Text="结束时间" TextColor="#8AA0B5" VerticalOptions="Center"
                               FontSize="{Binding Source={x:Reference ThisPage}, Path=CaptionFontSize}" />
                    </HorizontalStackLayout>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                        <DatePicker Date="{Binding CustomEndDate}"
                                    IsEnabled="{Binding UseCustomEnd}"
                                    FontSize="{Binding Source={x:Reference ThisPage}, Path=BodyFontSize}" />
                        <TimePicker Grid.Column="1"
                                    Time="{Binding CustomEndTime}"
                                    IsEnabled="{Binding UseCustomEnd}"
                                    FontSize="{Binding Source={x:Reference ThisPage}, Path=BodyFontSize}" />
                    </Grid>
                </VerticalStackLayout>
            </Grid>

            <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button Text="刷新"
                        Command="{Binding RefreshCommand}"
                        Padding="12,6"
                        FontSize="{Binding Source={x:Reference ThisPage}, Path=ButtonFontSize}" />
                <Button Grid.Column="1"
                        Text="删除筛选"
                        Command="{Binding ClearFilteredCommand}"
                        Padding="12,6"
                        FontSize="{Binding Source={x:Reference ThisPage}, Path=ButtonFontSize}" />
                <Button Grid.Column="2"
                        Text="清空全部"
                        Command="{Binding ClearAllCommand}"
                        Padding="12,6"
                        FontSize="{Binding Source={x:Reference ThisPage}, Path=ButtonFontSize}" />
            </Grid>
        </Grid>

        <Grid Grid.Row="2"
              RowDefinitions="*,Auto"
              x:Name="TableHost">
            <Grid Grid.Row="0"
                  RowDefinitions="Auto,*"
                  IsVisible="{Binding ShowEmpty, Converter={StaticResource InverseBoolConverter}}">
                <Grid Grid.Row="0"
                      ColumnDefinitions="*,Auto">
                    <ScrollView Grid.Column="0"
                                x:Name="HeaderHorizontalScroll"
                                Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Never"
                                VerticalScrollBarVisibility="Never"
                                Scrolled="OnHeaderHorizontalScrolled">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="4"
                              WidthRequest="{Binding TableContentMinWidth}">
                            <Border Grid.Column="0"
                                    Stroke="#1F3A52"
                                    StrokeThickness="1"
                                    BackgroundColor="#152536"
                                    Padding="8,4">
                                <HorizontalStackLayout Spacing="{x:Static services:HistoryTableFormatting.ColumnSpacing}">
                                    <controls:ResizableHistoryColumnHeader HeaderText="时间"
                                                                           ColumnWidth="{Binding TimeColumnWidth}"
                                                                           UseMonospaceFont="True"
                                                                           HeaderFontSize="{Binding Source={x:Reference ThisPage}, Path=BodyFontSize}" />
                                    <controls:ResizableHistoryColumnHeader HeaderText="设备"
                                                                           ColumnWidth="{Binding DeviceColumnWidth}"
                                                                           HeaderFontSize="{Binding Source={x:Reference ThisPage}, Path=BodyFontSize}" />
                                    <HorizontalStackLayout Spacing="{x:Static services:HistoryTableFormatting.ColumnSpacing}"
                                                           BindableLayout.ItemsSource="{Binding TableColumns}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="services:HistoryTableColumn">
                                                <controls:ResizableHistoryColumnHeader HeaderText="{Binding HeaderText}"
                                                                                       ColumnWidth="{Binding Width}"
                                                                                       HeaderFontSize="{Binding Source={x:Reference ThisPage}, Path=BodyFontSize}" />
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </HorizontalStackLayout>
                                </HorizontalStackLayout>
                            </Border>
                            <BoxView Grid.Column="1"
                                     WidthRequest="{x:Static services:HistoryTableFormatting.DeleteColumnWidth}"
                                     Color="Transparent" />
                        </Grid>
                    </ScrollView>
                    <BoxView Grid.Column="1"
                             WidthRequest="{x:Static services:HistoryTableFormatting.VerticalScrollBarGutter}"
                             Color="Transparent" />
                </Grid>

                <ScrollView Grid.Row="1"
                            x:Name="BodyVerticalScroll"
                            VerticalScrollBarVisibility="Always">
                    <ScrollView x:Name="BodyHorizontalScroll"
                                Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Always"
                                VerticalScrollBarVisibility="Never"
                                Scrolled="OnBodyHorizontalScrolled">
                        <VerticalStackLayout WidthRequest="{Binding TableContentMinWidth}"
                                             BindableLayout.ItemsSource="{Binding TableRows}"
                                             Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="services:HistoryTableRow">
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="4"
                                          Padding="0,1">
                                        <Border Grid.Column="0"
                                                Stroke="#1F3A52"
                                                StrokeThickness="1"
                                                BackgroundColor="#101C28"
                                                Padding="8,4">
                                            <HorizontalStackLayout Spacing="{x:Static services:HistoryTableFormatting.ColumnSpacing}">
                                                <Label Text="{Binding RecordedAtText}"
                                                       WidthRequest="{Binding Source={x:Reference ThisPage}, Path=BindingContext.TimeColumnWidth}"
                                                       FontFamily="Consolas"
                                                       TextColor="White"
                                                       FontSize="{Binding Source={x:Reference ThisPage}, Path=BodyFontSize}"
                                                       LineBreakMode="TailTruncation"
                                                       VerticalOptions="Center" />
                                                <Label Text="{Binding DeviceId}"
                                                       WidthRequest="{Binding Source={x:Reference ThisPage}, Path=BindingContext.DeviceColumnWidth}"
                                                       TextColor="White"
                                                       FontSize="{Binding Source={x:Reference ThisPage}, Path=BodyFontSize}"
                                                       LineBreakMode="TailTruncation"
                                                       VerticalOptions="Center" />
                                                <HorizontalStackLayout Spacing="{x:Static services:HistoryTableFormatting.ColumnSpacing}"
                                                                       BindableLayout.ItemsSource="{Binding TagCells}">
                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate x:DataType="services:HistoryTableCell">
                                                            <Label Text="{Binding Text}"
                                                                   WidthRequest="{Binding Width}"
                                                                   FontFamily="Consolas"
                                                                   TextColor="White"
                                                                   FontSize="{Binding Source={x:Reference ThisPage}, Path=BodyFontSize}"
                                                                   HorizontalTextAlignment="End"
                                                                   LineBreakMode="TailTruncation"
                                                                   VerticalOptions="Center" />
                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </HorizontalStackLayout>
                                            </HorizontalStackLayout>
                                        </Border>
                                        <Button Grid.Column="1"
                                                Text="删"
                                                WidthRequest="{x:Static services:HistoryTableFormatting.DeleteColumnWidth}"
                                                VerticalOptions="Center"
                                                Padding="4,2"
                                                FontSize="{Binding Source={x:Reference ThisPage}, Path=CaptionFontSize}"
                                                BackgroundColor="#3A1F1F"
                                                TextColor="#FF6B6B"
                                                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.DeleteRowCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </ScrollView>
                </ScrollView>
            </Grid>

            <VerticalStackLayout Grid.Row="1"
                                 Padding="8,6"
                                 Spacing="6"
                                 IsVisible="{Binding ShowEmpty, Converter={StaticResource InverseBoolConverter}}">
                <Button Text="加载更多"
                        Command="{Binding LoadMoreCommand}"
                        IsVisible="{Binding CanLoadMore}"
                        Padding="12,6"
                        FontSize="{Binding Source={x:Reference ThisPage}, Path=ButtonFontSize}" />
                <ActivityIndicator IsRunning="{Binding IsLoadingMore}"
                                   IsVisible="{Binding IsLoadingMore}"
                                   Color="#2EC4B6"
                                   HorizontalOptions="Center" />
                <Label Text="已加载全部记录"
                       TextColor="#6E8499"
                       FontSize="{Binding Source={x:Reference ThisPage}, Path=CaptionFontSize}"
                       HorizontalOptions="Center"
                       IsVisible="{Binding CanLoadMore, Converter={StaticResource InverseBoolConverter}}" />
            </VerticalStackLayout>

            <Label Grid.RowSpan="2"
                   Text="当前筛选条件下没有历史记录。"
                   TextColor="#8AA0B5"
                   IsVisible="{Binding ShowEmpty}"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   FontSize="{Binding Source={x:Reference ThisPage}, Path=BodyFontSize}" />

            <ActivityIndicator Grid.RowSpan="2"
                               IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="#2EC4B6"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />
        </Grid>

        <Label Grid.Row="3"
               Text="{Binding StatusMessage}"
               TextColor="#FF6B6B"
               LineBreakMode="WordWrap"
               IsVisible="{Binding StatusMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}"
               FontSize="{Binding Source={x:Reference ThisPage}, Path=CaptionFontSize}" />
    </Grid>
</views:MonitorPageBase>
