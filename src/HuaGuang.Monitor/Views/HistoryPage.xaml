<?xml version="1.0" encoding="utf-8" ?>
<views:MonitorPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:HuaGuang.Monitor.Views"
             xmlns:vm="clr-namespace:HuaGuang.Monitor.ViewModels"
             xmlns:services="clr-namespace:HuaGuang.Monitor.Services"
             x:Class="HuaGuang.Monitor.Views.HistoryPage"
             x:Name="ThisPage"
             x:DataType="vm:HistoryViewModel"
             Shell.NavBarIsVisible="False"
             SafeAreaEdges="All"
             BackgroundColor="#0B1522">

    <Grid RowDefinitions="Auto,Auto,*,Auto"
          Padding="{Binding Source={x:Reference ThisPage}, Path=IsCompactLayout, Converter={StaticResource PagePaddingConverter}}"
          RowSpacing="8">
        <VerticalStackLayout Spacing="2">
            <Label Text="历史数据" TextColor="White" FontAttributes="Bold"
                   FontSize="{Binding Source={x:Reference ThisPage}, Path=TitleFontSize}" />
            <Label Text="{Binding SummaryText}" TextColor="#8AA0B5" LineBreakMode="WordWrap"
                   FontSize="{Binding Source={x:Reference ThisPage}, Path=CaptionFontSize}" />
            <Label Text="先点「刷新」加载数据；修改筛选条件后需再次刷新；下滑到底部加载更多。"
                   TextColor="#6E8499"
                   FontSize="{Binding Source={x:Reference ThisPage}, Path=CaptionFontSize}" />
        </VerticalStackLayout>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6">
            <VerticalStackLayout Spacing="2">
                <Label Text="时间范围" TextColor="#8AA0B5" FontSize="12" />
                <Picker ItemsSource="{Binding RangeOptions}" SelectedItem="{Binding SelectedRange}"
                        FontSize="{Binding Source={x:Reference ThisPage}, Path=BodyFontSize}" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" Spacing="2">
                <Label Text="设备" TextColor="#8AA0B5" FontSize="12" />
                <Picker ItemsSource="{Binding DeviceOptions}" SelectedItem="{Binding SelectedDevice}"
                        FontSize="{Binding Source={x:Reference ThisPage}, Path=BodyFontSize}" />
            </VerticalStackLayout>
            <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button Text="刷新"
                        Command="{Binding RefreshCommand}"
                        Padding="12,6"
                        FontSize="{Binding Source={x:Reference ThisPage}, Path=ButtonFontSize}" />
                <Button Grid.Column="1"
                        Text="删除筛选"
                        Command="{Binding ClearFilteredCommand}"
                        Padding="12,6"
                        FontSize="{Binding Source={x:Reference ThisPage}, Path=ButtonFontSize}" />
                <Button Grid.Column="2"
                        Text="清空全部"
                        Command="{Binding ClearAllCommand}"
                        Padding="12,6"
                        FontSize="{Binding Source={x:Reference ThisPage}, Path=ButtonFontSize}" />
            </Grid>
        </Grid>

        <Grid Grid.Row="2" RowDefinitions="Auto,*">
            <Border Grid.Row="0"
                    Stroke="#1F3A52"
                    StrokeThickness="1"
                    BackgroundColor="#152536"
                    Padding="8,6"
                    IsVisible="{Binding ShowEmpty, Converter={StaticResource InverseBoolConverter}}">
                <Label Text="{Binding HeaderLine}"
                       FontFamily="Consolas"
                       FontAttributes="Bold"
                       TextColor="#8AA0B5"
                       FontSize="{Binding Source={x:Reference ThisPage}, Path=CaptionFontSize}"
                       LineBreakMode="CharacterWrap" />
            </Border>

            <CollectionView Grid.Row="1"
                            ItemsSource="{Binding TableRows}"
                            SelectionMode="None"
                            RemainingItemsThreshold="5"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                            IsVisible="{Binding ShowEmpty, Converter={StaticResource InverseBoolConverter}}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="services:HistoryTableRow">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="4"
                              Padding="0,2">
                            <Border Stroke="#1F3A52" StrokeThickness="1" BackgroundColor="#101C28" Padding="8,4">
                                <Label Text="{Binding LineText}"
                                       FontFamily="Consolas"
                                       TextColor="White"
                                       FontSize="{Binding Source={x:Reference ThisPage}, Path=BodyFontSize}"
                                       LineBreakMode="CharacterWrap"
                                       MaxLines="2" />
                            </Border>
                            <Button Grid.Column="1"
                                    Text="删"
                                    WidthRequest="44"
                                    VerticalOptions="Center"
                                    Padding="4,2"
                                    FontSize="{Binding Source={x:Reference ThisPage}, Path=CaptionFontSize}"
                                    BackgroundColor="#3A1F1F"
                                    TextColor="#FF6B6B"
                                    Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.DeleteRowCommand}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <VerticalStackLayout Padding="8,6" Spacing="6">
                        <Button Text="加载更多"
                                Command="{Binding LoadMoreCommand}"
                                IsVisible="{Binding CanLoadMore}"
                                Padding="12,6"
                                FontSize="{Binding Source={x:Reference ThisPage}, Path=ButtonFontSize}" />
                        <ActivityIndicator IsRunning="{Binding IsLoadingMore}"
                                           IsVisible="{Binding IsLoadingMore}"
                                           Color="#2EC4B6"
                                           HorizontalOptions="Center" />
                        <Label Text="已加载全部记录"
                               TextColor="#6E8499"
                               FontSize="{Binding Source={x:Reference ThisPage}, Path=CaptionFontSize}"
                               HorizontalOptions="Center"
                               IsVisible="{Binding CanLoadMore, Converter={StaticResource InverseBoolConverter}}" />
                    </VerticalStackLayout>
                </CollectionView.Footer>
            </CollectionView>

            <Label Grid.RowSpan="2"
                   Text="当前筛选条件下没有历史记录。"
                   TextColor="#8AA0B5"
                   IsVisible="{Binding ShowEmpty}"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   FontSize="{Binding Source={x:Reference ThisPage}, Path=BodyFontSize}" />

            <ActivityIndicator Grid.RowSpan="2"
                               IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="#2EC4B6"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />
        </Grid>

        <Label Grid.Row="3"
               Text="{Binding StatusMessage}"
               TextColor="#FF6B6B"
               LineBreakMode="WordWrap"
               IsVisible="{Binding StatusMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}"
               FontSize="{Binding Source={x:Reference ThisPage}, Path=CaptionFontSize}" />
    </Grid>
</views:MonitorPageBase>
