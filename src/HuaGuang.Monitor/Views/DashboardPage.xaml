<?xml version="1.0" encoding="utf-8" ?>
<views:MonitorPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:HuaGuang.Monitor.Views"
             xmlns:controls="clr-namespace:HuaGuang.Monitor.Controls"
             xmlns:vm="clr-namespace:HuaGuang.Monitor.ViewModels"
             x:Class="HuaGuang.Monitor.Views.DashboardPage"
             x:Name="ThisPage"
             x:DataType="vm:DashboardViewModel"
             Shell.NavBarIsVisible="False"
             SafeAreaEdges="All"
             BackgroundColor="#0B1522">

    <views:MonitorPageBase.Resources>
        <DataTemplate x:Key="DashboardTagCardTemplate" x:DataType="vm:TagRowViewModel">
            <Border Stroke="{Binding CardBorderColor}"
                    StrokeThickness="{Binding IsBool, Converter={StaticResource BoolToSwitchStrokeConverter}}"
                    BackgroundColor="{Binding CardBackgroundColor}"
                    Padding="{Binding Source={RelativeSource AncestorType={x:Type controls:FitGrid}}, Path=CardPadding}"
                    MinimumHeightRequest="{Binding Source={RelativeSource AncestorType={x:Type controls:FitGrid}}, Path=MinItemHeight}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type views:DashboardPage}}, Path=BindingContext.EditSettingTagCommand}"
                                          CommandParameter="{Binding .}" />
                </Border.GestureRecognizers>

                <Grid IsVisible="{Binding IsBool}" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border WidthRequest="52"
                            HeightRequest="52"
                            BackgroundColor="{Binding ValueColor}"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="26" />
                        </Border.StrokeShape>
                        <Label Text="{Binding BoolIndicatorText}"
                               TextColor="White"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               FontSize="{Binding Source={RelativeSource AncestorType={x:Type controls:FitGrid}}, Path=ValueFontSize}" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label Text="{Binding Name}"
                               TextColor="#C9D6E2"
                               LineBreakMode="TailTruncation"
                               MaxLines="2"
                               FontSize="{Binding Source={RelativeSource AncestorType={x:Type controls:FitGrid}}, Path=BodyFontSize}" />
                        <Label Text="{Binding BoolStatusText}"
                               TextColor="{Binding ValueColor}"
                               FontAttributes="Bold"
                               FontSize="{Binding Source={RelativeSource AncestorType={x:Type controls:FitGrid}}, Path=ValueFontSize}" />
                        <HorizontalStackLayout Spacing="6">
                            <BoxView WidthRequest="7" HeightRequest="7" CornerRadius="4" VerticalOptions="Center" Color="{Binding QualityColor}" />
                            <Label Text="{Binding UpdatedAt}" TextColor="#8AA0B5"
                                   FontSize="{Binding Source={RelativeSource AncestorType={x:Type controls:FitGrid}}, Path=SmallFontSize}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>

                <Grid IsVisible="{Binding IsBool, Converter={StaticResource InverseBoolConverter}}" ColumnDefinitions="4,*">
                    <BoxView Grid.Column="0" Color="{Binding ValueColor}" WidthRequest="4" VerticalOptions="Fill" />
                    <VerticalStackLayout Grid.Column="1" Spacing="4" Padding="4,0,0,0">
                        <Label Text="{Binding Name}"
                               TextColor="#C9D6E2"
                               LineBreakMode="TailTruncation"
                               MaxLines="2"
                               FontSize="{Binding Source={RelativeSource AncestorType={x:Type controls:FitGrid}}, Path=BodyFontSize}" />
                        <HorizontalStackLayout Spacing="4">
                            <Label Text="{Binding DisplayValue}"
                                   TextColor="{Binding ValueColor}"
                                   FontAttributes="Bold"
                                   LineBreakMode="TailTruncation"
                                   FontSize="{Binding Source={RelativeSource AncestorType={x:Type controls:FitGrid}}, Path=ValueFontSize}" />
                            <Label Text="{Binding Unit}"
                                   TextColor="#8AA0B5"
                                   VerticalOptions="End"
                                   Margin="0,0,0,2"
                                   FontSize="{Binding Source={RelativeSource AncestorType={x:Type controls:FitGrid}}, Path=CaptionFontSize}" />
                        </HorizontalStackLayout>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <Label Text="{Binding AddressText}" TextColor="#6E8499" LineBreakMode="TailTruncation"
                                   FontSize="{Binding Source={RelativeSource AncestorType={x:Type controls:FitGrid}}, Path=SmallFontSize}" />
                            <Label Grid.Column="1"
                                   Text="{Binding EditHintText}"
                                   TextColor="#7B9FD4"
                                   HorizontalOptions="End"
                                   IsVisible="{Binding IsEditableSetting}"
                                   FontSize="{Binding Source={RelativeSource AncestorType={x:Type controls:FitGrid}}, Path=SmallFontSize}" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="4"
                                                   IsVisible="{Binding IsEditableSetting, Converter={StaticResource InverseBoolConverter}}">
                                <BoxView WidthRequest="7" HeightRequest="7" CornerRadius="4" VerticalOptions="Center" Color="{Binding QualityColor}" />
                                <Label Text="{Binding UpdatedAt}" TextColor="#8AA0B5"
                                       FontSize="{Binding Source={RelativeSource AncestorType={x:Type controls:FitGrid}}, Path=SmallFontSize}" />
                            </HorizontalStackLayout>
                        </Grid>
                        <HorizontalStackLayout Spacing="4" IsVisible="{Binding IsEditableSetting}">
                            <BoxView WidthRequest="7" HeightRequest="7" CornerRadius="4" VerticalOptions="Center" Color="{Binding QualityColor}" />
                            <Label Text="{Binding UpdatedAt}" TextColor="#8AA0B5"
                                   FontSize="{Binding Source={RelativeSource AncestorType={x:Type controls:FitGrid}}, Path=SmallFontSize}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="DashboardSwitchChipTemplate" x:DataType="vm:TagRowViewModel">
            <Border Stroke="{Binding CardBorderColor}"
                    StrokeThickness="2"
                    BackgroundColor="{Binding CardBackgroundColor}"
                    Padding="8,6"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <HorizontalStackLayout Spacing="8"
                                       VerticalOptions="Center"
                                       HorizontalOptions="Fill">
                    <Border WidthRequest="36"
                            HeightRequest="36"
                            BackgroundColor="{Binding ValueColor}"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <Label Text="{Binding BoolIndicatorText}"
                               TextColor="White"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               FontSize="{Binding Source={RelativeSource AncestorType={x:Type views:DashboardPage}}, Path=BodyFontSize}" />
                    </Border>
                    <VerticalStackLayout Spacing="0"
                                         VerticalOptions="Center"
                                         HorizontalOptions="FillAndExpand">
                        <Label Text="{Binding Name}"
                               TextColor="#C9D6E2"
                               LineBreakMode="TailTruncation"
                               MaxLines="1"
                               HorizontalOptions="Start"
                               FontSize="{Binding Source={RelativeSource AncestorType={x:Type views:DashboardPage}}, Path=CaptionFontSize}" />
                        <Label Text="{Binding BoolStatusText}"
                               TextColor="{Binding ValueColor}"
                               FontAttributes="Bold"
                               LineBreakMode="TailTruncation"
                               MaxLines="1"
                               HorizontalOptions="Start"
                               FontSize="{Binding Source={RelativeSource AncestorType={x:Type views:DashboardPage}}, Path=BodyFontSize}" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RemoteDevicePanelTemplate" x:DataType="vm:RemoteDevicePanelViewModel">
            <VerticalStackLayout Spacing="8" Margin="0,0,0,10">
                <Border Stroke="#1F3A52" StrokeThickness="1" BackgroundColor="#101C28" Padding="10,8">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding DeviceId}" TextColor="White" FontAttributes="Bold"
                               FontSize="{Binding Source={RelativeSource AncestorType={x:Type views:DashboardPage}}, Path=BodyFontSize}" />
                        <Label Text="{Binding StatusText}" TextColor="#8AA0B5" LineBreakMode="WordWrap"
                               FontSize="{Binding Source={RelativeSource AncestorType={x:Type views:DashboardPage}}, Path=CaptionFontSize}" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding TagGroups}" Spacing="14">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:TagGroupViewModel">
                            <VerticalStackLayout Spacing="6">
                                <HorizontalStackLayout Spacing="8">
                                    <BoxView WidthRequest="4"
                                             HeightRequest="18"
                                             Color="{Binding AccentBrush}"
                                             VerticalOptions="Center"
                                             CornerRadius="2" />
                                    <Label Text="{Binding Title}"
                                           TextColor="{Binding AccentBrush}"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center"
                                           FontSize="{Binding Source={RelativeSource AncestorType={x:Type views:DashboardPage}}, Path=BodyFontSize}" />
                                    <Label Text="{Binding Tags.Count, StringFormat='({0})'}"
                                           TextColor="#8AA0B5"
                                           VerticalOptions="Center"
                                           FontSize="{Binding Source={RelativeSource AncestorType={x:Type views:DashboardPage}}, Path=CaptionFontSize}" />
                                </HorizontalStackLayout>

                                <controls:FitGrid ItemsSource="{Binding Tags}"
                                                  PreferFill="False"
                                                  MinItemWidth="{Binding Source={RelativeSource AncestorType={x:Type views:DashboardPage}}, Path=CardMinWidth}"
                                                  MinItemHeight="{Binding Source={RelativeSource AncestorType={x:Type views:DashboardPage}}, Path=CardMinHeight}"
                                                  CardPadding="{Binding Source={RelativeSource AncestorType={x:Type views:DashboardPage}}, Path=CardPadding}"
                                                  BodyFontSize="{Binding Source={RelativeSource AncestorType={x:Type views:DashboardPage}}, Path=BodyFontSize}"
                                                  ValueFontSize="{Binding Source={RelativeSource AncestorType={x:Type views:DashboardPage}}, Path=ValueFontSize}"
                                                  CaptionFontSize="{Binding Source={RelativeSource AncestorType={x:Type views:DashboardPage}}, Path=CaptionFontSize}"
                                                  SmallFontSize="{Binding Source={RelativeSource AncestorType={x:Type views:DashboardPage}}, Path=SmallFontSize}"
                                                  ItemTemplate="{StaticResource DashboardTagCardTemplate}" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </DataTemplate>
    </views:MonitorPageBase.Resources>

    <Grid x:Name="RootGrid"
          RowDefinitions="Auto,*"
          Padding="{Binding Source={x:Reference ThisPage}, Path=IsCompactLayout, Converter={StaticResource PagePaddingConverter}}"
          RowSpacing="{Binding Source={x:Reference ThisPage}, Path=IsCompactLayout, Converter={StaticResource RowSpacingConverter}}">
        <!-- 竖屏：标题 / 按钮 / 开关 分行 -->
        <VerticalStackLayout Spacing="6"
                             IsVisible="{Binding Source={x:Reference ThisPage}, Path=IsLandscape, Converter={StaticResource InverseBoolConverter}}">
            <VerticalStackLayout Spacing="0">
                <Label Text="工业监控" TextColor="White" FontAttributes="Bold"
                       FontSize="{Binding Source={x:Reference ThisPage}, Path=TitleFontSize}" />
                <Label Text="{Binding DeviceId, StringFormat='设备 {0}'}" TextColor="#8AA0B5" LineBreakMode="TailTruncation"
                       FontSize="{Binding Source={x:Reference ThisPage}, Path=SubtitleFontSize}" />
                <Label Text="{Binding ModeText}" TextColor="#2EC4B6" LineBreakMode="TailTruncation" MaxLines="2"
                       FontSize="{Binding Source={x:Reference ThisPage}, Path=SubtitleFontSize}" />
            </VerticalStackLayout>

            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="6" HorizontalOptions="End">
                    <Border Stroke="#1F3A52" StrokeThickness="1" BackgroundColor="#152536" Padding="8,6"
                            IsVisible="{Binding IsAcquisitionMode}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <HorizontalStackLayout Spacing="6">
                            <BoxView WidthRequest="7" HeightRequest="7" CornerRadius="4" VerticalOptions="Center"
                                     Color="{Binding PlcConnected, Converter={StaticResource BoolToStatusColorConverter}}" />
                            <VerticalStackLayout Spacing="0">
                                <Label Text="PLC" TextColor="#8AA0B5"
                                       FontSize="{Binding Source={x:Reference ThisPage}, Path=SmallFontSize}" />
                                <Label Text="{Binding PlcConnected, Converter={StaticResource BoolToConnectedTextConverter}}" TextColor="White"
                                       FontSize="{Binding Source={x:Reference ThisPage}, Path=BodyFontSize}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>

                    <Border Stroke="#1F3A52" StrokeThickness="1" BackgroundColor="#152536" Padding="8,6">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <HorizontalStackLayout Spacing="6">
                            <BoxView WidthRequest="7" HeightRequest="7" CornerRadius="4" VerticalOptions="Center"
                                     Color="{Binding MqttConnected, Converter={StaticResource BoolToStatusColorConverter}}" />
                            <VerticalStackLayout Spacing="0">
                                <Label Text="MQTT" TextColor="#8AA0B5"
                                       FontSize="{Binding Source={x:Reference ThisPage}, Path=SmallFontSize}" />
                                <Label Text="{Binding MqttConnected, Converter={StaticResource BoolToConnectedTextConverter}}" TextColor="White"
                                       FontSize="{Binding Source={x:Reference ThisPage}, Path=BodyFontSize}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>

                    <Button Text="{Binding Source={x:Reference ThisPage}, Path=IsFullScreenMode, Converter={StaticResource FullScreenLabelConverter}}"
                            Clicked="OnFullScreenClicked"
                            Padding="12,8"
                            MinimumWidthRequest="72"
                            VerticalOptions="Center"
                            FontSize="{Binding Source={x:Reference ThisPage}, Path=ButtonFontSize}" />

                    <Button Text="{Binding ToggleText}"
                            Command="{Binding ToggleCommand}"
                            IsEnabled="{Binding IsToggleBusy, Converter={StaticResource InverseBoolConverter}}"
                            Padding="12,8"
                            MinimumWidthRequest="88"
                            VerticalOptions="Center"
                            FontSize="{Binding Source={x:Reference ThisPage}, Path=ButtonFontSize}" />
                </HorizontalStackLayout>
            </ScrollView>

            <controls:EqualWidthRowLayout ItemsSource="{Binding SwitchStatusTags}"
                                          ItemTemplate="{StaticResource DashboardSwitchChipTemplate}"
                                          MinimumHeightRequest="52"
                                          HorizontalOptions="Fill"
                                          VerticalOptions="Fill"
                                          IsVisible="{Binding HasSwitchStatusTags}" />
        </VerticalStackLayout>

        <!-- 横屏：单行三列 -->
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8"
              IsVisible="{Binding Source={x:Reference ThisPage}, Path=IsLandscape}">
            <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                <Label Text="工业监控" TextColor="White" FontAttributes="Bold"
                       FontSize="{Binding Source={x:Reference ThisPage}, Path=TitleFontSize}" />
                <Label Text="{Binding DeviceId, StringFormat='设备 {0}'}" TextColor="#8AA0B5" LineBreakMode="TailTruncation"
                       FontSize="{Binding Source={x:Reference ThisPage}, Path=SubtitleFontSize}" />
                <Label Text="{Binding ModeText}" TextColor="#2EC4B6" LineBreakMode="TailTruncation" MaxLines="2"
                       FontSize="{Binding Source={x:Reference ThisPage}, Path=SubtitleFontSize}" />
            </VerticalStackLayout>

            <controls:EqualWidthRowLayout Grid.Column="1"
                                          ItemsSource="{Binding SwitchStatusTags}"
                                          ItemTemplate="{StaticResource DashboardSwitchChipTemplate}"
                                          MinimumHeightRequest="52"
                                          HorizontalOptions="Fill"
                                          VerticalOptions="Fill"
                                          IsVisible="{Binding HasSwitchStatusTags}" />

            <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                <Border Stroke="#1F3A52" StrokeThickness="1" BackgroundColor="#152536" Padding="8,6"
                        IsVisible="{Binding IsAcquisitionMode}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <HorizontalStackLayout Spacing="6">
                        <BoxView WidthRequest="7" HeightRequest="7" CornerRadius="4" VerticalOptions="Center"
                                 Color="{Binding PlcConnected, Converter={StaticResource BoolToStatusColorConverter}}" />
                        <VerticalStackLayout Spacing="0">
                            <Label Text="PLC" TextColor="#8AA0B5"
                                   FontSize="{Binding Source={x:Reference ThisPage}, Path=SmallFontSize}" />
                            <Label Text="{Binding PlcConnected, Converter={StaticResource BoolToConnectedTextConverter}}" TextColor="White"
                                   FontSize="{Binding Source={x:Reference ThisPage}, Path=BodyFontSize}" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>

                <Border Stroke="#1F3A52" StrokeThickness="1" BackgroundColor="#152536" Padding="8,6">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <HorizontalStackLayout Spacing="6">
                        <BoxView WidthRequest="7" HeightRequest="7" CornerRadius="4" VerticalOptions="Center"
                                 Color="{Binding MqttConnected, Converter={StaticResource BoolToStatusColorConverter}}" />
                        <VerticalStackLayout Spacing="0">
                            <Label Text="MQTT" TextColor="#8AA0B5"
                                   FontSize="{Binding Source={x:Reference ThisPage}, Path=SmallFontSize}" />
                            <Label Text="{Binding MqttConnected, Converter={StaticResource BoolToConnectedTextConverter}}" TextColor="White"
                                   FontSize="{Binding Source={x:Reference ThisPage}, Path=BodyFontSize}" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>

                <Button Text="{Binding Source={x:Reference ThisPage}, Path=IsFullScreenMode, Converter={StaticResource FullScreenLabelConverter}}"
                        Clicked="OnFullScreenClicked"
                        Padding="12,8"
                        MinimumWidthRequest="72"
                        VerticalOptions="Center"
                        FontSize="{Binding Source={x:Reference ThisPage}, Path=ButtonFontSize}" />

                <Button Text="{Binding ToggleText}"
                        Command="{Binding ToggleCommand}"
                        IsEnabled="{Binding IsToggleBusy, Converter={StaticResource InverseBoolConverter}}"
                        Padding="12,8"
                        MinimumWidthRequest="88"
                        VerticalOptions="Center"
                        FontSize="{Binding Source={x:Reference ThisPage}, Path=ButtonFontSize}" />
            </HorizontalStackLayout>
        </Grid>

        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" RowSpacing="4">
            <ScrollView x:Name="InfoPortrait"
                        MaximumHeightRequest="{Binding Source={x:Reference ThisPage}, Path=InfoPanelMaxHeight}">
                <ScrollView.IsVisible>
                    <MultiBinding Converter="{StaticResource AndBoolConverter}">
                        <Binding Source="{x:Reference ThisPage}" Path="ShowCompactInfoPanel" Converter="{StaticResource InverseBoolConverter}" />
                        <Binding Source="{x:Reference ThisPage}" Path="IsFullScreenMode" Converter="{StaticResource InverseBoolConverter}" />
                    </MultiBinding>
                </ScrollView.IsVisible>
                <VerticalStackLayout Spacing="4">
                    <VerticalStackLayout Spacing="4" IsVisible="{Binding IsSubscribeMode}">
                        <Label Text="主题筛选" TextColor="#8AA0B5"
                               FontSize="{Binding Source={x:Reference ThisPage}, Path=BodyFontSize}" />
                        <Picker ItemsSource="{Binding TopicFilters}" SelectedItem="{Binding SelectedTopicFilter}"
                                FontSize="{Binding Source={x:Reference ThisPage}, Path=BodyFontSize}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry Text="{Binding NewSubscribeTopic}" Placeholder="monitor/+/telemetry"
                                   FontSize="{Binding Source={x:Reference ThisPage}, Path=BodyFontSize}" />
                            <Button Grid.Column="1" Text="添加主题" Command="{Binding AddSubscribeTopicCommand}" MinimumWidthRequest="88"
                                    FontSize="{Binding Source={x:Reference ThisPage}, Path=ButtonFontSize}" />
                        </Grid>
                        <Label Text="{Binding LastError}"
                               TextColor="#FF6B6B"
                               LineBreakMode="WordWrap"
                               FontSize="{Binding Source={x:Reference ThisPage}, Path=BodyFontSize}"
                               IsVisible="{Binding LastError, Converter={StaticResource IsNotNullOrEmptyConverter}}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4" IsVisible="{Binding ShowRemoteDevicePicker}">
                        <Label Text="远程设备（可选全部或单台）" TextColor="#8AA0B5"
                               FontSize="{Binding Source={x:Reference ThisPage}, Path=BodyFontSize}" />
                        <Picker ItemsSource="{Binding RemoteDeviceItems}"
                                ItemDisplayBinding="{Binding Label}"
                                SelectedItem="{Binding SelectedRemoteDeviceItem}"
                                FontSize="{Binding Source={x:Reference ThisPage}, Path=BodyFontSize}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding TopicPreview, StringFormat='{0}'}" TextColor="#8AA0B5" LineBreakMode="WordWrap"
                               FontSize="{Binding Source={x:Reference ThisPage}, Path=BodyFontSize}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>

            <VerticalStackLayout Spacing="4">
                <VerticalStackLayout.IsVisible>
                    <MultiBinding Converter="{StaticResource AndBoolConverter}">
                        <Binding Source="{x:Reference ThisPage}" Path="ShowCompactInfoPanel" />
                        <Binding Source="{x:Reference ThisPage}" Path="IsFullScreenMode" Converter="{StaticResource InverseBoolConverter}" />
                    </MultiBinding>
                </VerticalStackLayout.IsVisible>
                <Grid ColumnDefinitions="Auto,*,Auto,*,*,Auto"
                      ColumnSpacing="8"
                      RowSpacing="0">
                    <Grid.IsVisible>
                        <MultiBinding Converter="{StaticResource AndBoolConverter}">
                            <Binding Source="{x:Reference ThisPage}" Path="IsExpandedLayout" />
                            <Binding Path="IsSubscribeMode" />
                        </MultiBinding>
                    </Grid.IsVisible>
                    <Label Text="主题" TextColor="#8AA0B5" VerticalOptions="Center"
                           FontSize="{Binding Source={x:Reference ThisPage}, Path=CaptionFontSize}"
                           IsVisible="{Binding IsSubscribeMode}" />
                    <Picker Grid.Column="1"
                            ItemsSource="{Binding TopicFilters}"
                            SelectedItem="{Binding SelectedTopicFilter}"
                            FontSize="{Binding Source={x:Reference ThisPage}, Path=BodyFontSize}"
                            IsVisible="{Binding IsSubscribeMode}" />
                    <Label Grid.Column="2" Text="设备" TextColor="#8AA0B5" VerticalOptions="Center"
                           FontSize="{Binding Source={x:Reference ThisPage}, Path=CaptionFontSize}"
                           IsVisible="{Binding ShowRemoteDevicePicker}" />
                    <Picker Grid.Column="3"
                            ItemsSource="{Binding RemoteDeviceItems}"
                            ItemDisplayBinding="{Binding Label}"
                            SelectedItem="{Binding SelectedRemoteDeviceItem}"
                            FontSize="{Binding Source={x:Reference ThisPage}, Path=BodyFontSize}"
                            IsVisible="{Binding ShowRemoteDevicePicker}" />
                    <Entry Grid.Column="4"
                           Text="{Binding NewSubscribeTopic}"
                           Placeholder="monitor/+/telemetry"
                           FontSize="{Binding Source={x:Reference ThisPage}, Path=BodyFontSize}"
                           IsVisible="{Binding IsSubscribeMode}" />
                    <Button Grid.Column="5"
                            Text="添加主题"
                            Command="{Binding AddSubscribeTopicCommand}"
                            Padding="12,6"
                            MinimumWidthRequest="88"
                            FontSize="{Binding Source={x:Reference ThisPage}, Path=ButtonFontSize}"
                            IsVisible="{Binding IsSubscribeMode}" />
                </Grid>

                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="8"
                      RowDefinitions="Auto,Auto"
                      RowSpacing="4">
                    <Grid.IsVisible>
                        <MultiBinding Converter="{StaticResource AndBoolConverter}">
                            <Binding Source="{x:Reference ThisPage}" Path="ShowCompactInfoPanel" />
                            <Binding Source="{x:Reference ThisPage}" Path="IsExpandedLayout" Converter="{StaticResource InverseBoolConverter}" />
                        </MultiBinding>
                    </Grid.IsVisible>
                    <VerticalStackLayout Spacing="2" IsVisible="{Binding IsSubscribeMode}">
                        <Label Text="主题" TextColor="#8AA0B5"
                               FontSize="{Binding Source={x:Reference ThisPage}, Path=CaptionFontSize}" />
                        <Picker ItemsSource="{Binding TopicFilters}" SelectedItem="{Binding SelectedTopicFilter}"
                                FontSize="{Binding Source={x:Reference ThisPage}, Path=BodyFontSize}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" IsVisible="{Binding ShowRemoteDevicePicker}">
                        <Label Text="设备（全部/单台）" TextColor="#8AA0B5"
                               FontSize="{Binding Source={x:Reference ThisPage}, Path=CaptionFontSize}" />
                        <Picker ItemsSource="{Binding RemoteDeviceItems}"
                                ItemDisplayBinding="{Binding Label}"
                                SelectedItem="{Binding SelectedRemoteDeviceItem}"
                                FontSize="{Binding Source={x:Reference ThisPage}, Path=BodyFontSize}" />
                    </VerticalStackLayout>
                    <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding IsSubscribeMode}">
                        <Entry Text="{Binding NewSubscribeTopic}" Placeholder="monitor/+/telemetry"
                               FontSize="{Binding Source={x:Reference ThisPage}, Path=BodyFontSize}" />
                        <Button Grid.Column="1" Text="添加" Command="{Binding AddSubscribeTopicCommand}" Padding="10,6"
                                FontSize="{Binding Source={x:Reference ThisPage}, Path=ButtonFontSize}" />
                    </Grid>
                    <Label Grid.Row="1" Grid.ColumnSpan="2"
                           Text="{Binding TopicPreview, StringFormat='{0}'}"
                           TextColor="#8AA0B5"
                           LineBreakMode="TailTruncation"
                           MaxLines="1"
                           FontSize="{Binding Source={x:Reference ThisPage}, Path=CaptionFontSize}"
                           IsVisible="{Binding IsSubscribeMode, Converter={StaticResource InverseBoolConverter}}" />
                </Grid>

                <Grid ColumnDefinitions="*"
                      ColumnSpacing="8">
                    <Label Text="{Binding TopicPreview, StringFormat='{0}'}"
                           TextColor="#8AA0B5"
                           LineBreakMode="TailTruncation"
                           MaxLines="1"
                           VerticalOptions="Center"
                           FontSize="{Binding Source={x:Reference ThisPage}, Path=CaptionFontSize}" />
                </Grid>
            </VerticalStackLayout>

            <Border Grid.Row="1"
                    Stroke="#1F3A52"
                    StrokeThickness="1"
                    BackgroundColor="#152536"
                    Padding="10,8"
                    IsVisible="{Binding ShowScannerInput}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="{Binding ScannerInputTitle}"
                               TextColor="#8AA0B5"
                               VerticalOptions="Center"
                               LineBreakMode="WordWrap"
                               FontSize="{Binding Source={x:Reference ThisPage}, Path=CaptionFontSize}" />
                        <Button Grid.Column="1"
                                Text="取消"
                                Command="{Binding CancelScannerInputCommand}"
                                Padding="10,4"
                                BackgroundColor="Transparent"
                                TextColor="#8AA0B5"
                                FontSize="{Binding Source={x:Reference ThisPage}, Path=CaptionFontSize}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry x:Name="ScannerInputEntry"
                               Text="{Binding ScannerInputDraft}"
                               Placeholder="请扫码或输入，回车确认"
                               ReturnType="Done"
                               ReturnCommand="{Binding SubmitScannerInputCommand}"
                               MaxLength="200"
                               FontSize="{Binding Source={x:Reference ThisPage}, Path=BodyFontSize}"
                               Focused="OnScannerInputEntryFocused"
                               Completed="OnScannerInputCompleted" />
                        <Button Grid.Column="1"
                                Text="确认"
                                Command="{Binding SubmitScannerInputCommand}"
                                Padding="14,8"
                                MinimumWidthRequest="72"
                                FontSize="{Binding Source={x:Reference ThisPage}, Path=ButtonFontSize}" />
                    </Grid>
                    <Label Text="{Binding LastError}"
                           TextColor="#FF6B6B"
                           LineBreakMode="WordWrap"
                           FontSize="{Binding Source={x:Reference ThisPage}, Path=CaptionFontSize}"
                           IsVisible="{Binding LastError, Converter={StaticResource IsNotNullOrEmptyConverter}}" />
                </VerticalStackLayout>
            </Border>

            <ScrollView Grid.Row="2">
                <VerticalStackLayout Spacing="14" Padding="0,4">
                    <Label Text="{Binding EmptyTagsHint}"
                           TextColor="#8AA0B5"
                           LineBreakMode="WordWrap"
                           IsVisible="{Binding ShowEmptyTagsHint}"
                           FontSize="{Binding Source={x:Reference ThisPage}, Path=BodyFontSize}" />

                    <VerticalStackLayout IsVisible="{Binding ShowSingleDeviceDashboard}"
                                         BindableLayout.ItemsSource="{Binding TagGroups}"
                                         Spacing="14">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:TagGroupViewModel">
                                <VerticalStackLayout Spacing="6">
                                    <HorizontalStackLayout Spacing="8">
                                        <BoxView WidthRequest="4"
                                                 HeightRequest="18"
                                                 Color="{Binding AccentBrush}"
                                                 VerticalOptions="Center"
                                                 CornerRadius="2" />
                                        <Label Text="{Binding Title}"
                                               TextColor="{Binding AccentBrush}"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center"
                                               FontSize="{Binding Source={x:Reference ThisPage}, Path=BodyFontSize}" />
                                        <Label Text="{Binding Tags.Count, StringFormat='({0})'}"
                                               TextColor="#8AA0B5"
                                               VerticalOptions="Center"
                                               FontSize="{Binding Source={x:Reference ThisPage}, Path=CaptionFontSize}" />
                                    </HorizontalStackLayout>

                                    <controls:FitGrid ItemsSource="{Binding Tags}"
                                                      PreferFill="False"
                                                      MinItemWidth="{Binding Source={x:Reference ThisPage}, Path=CardMinWidth}"
                                                      MinItemHeight="{Binding Source={x:Reference ThisPage}, Path=CardMinHeight}"
                                                      CardPadding="{Binding Source={x:Reference ThisPage}, Path=CardPadding}"
                                                      BodyFontSize="{Binding Source={x:Reference ThisPage}, Path=BodyFontSize}"
                                                      ValueFontSize="{Binding Source={x:Reference ThisPage}, Path=ValueFontSize}"
                                                      CaptionFontSize="{Binding Source={x:Reference ThisPage}, Path=CaptionFontSize}"
                                                      SmallFontSize="{Binding Source={x:Reference ThisPage}, Path=SmallFontSize}"
                                                      ItemTemplate="{StaticResource DashboardTagCardTemplate}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding ShowMultiDeviceDashboard}"
                                         BindableLayout.ItemsSource="{Binding RemoteDevicePanels}"
                                         BindableLayout.ItemTemplate="{StaticResource RemoteDevicePanelTemplate}"
                                         Spacing="16" />
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</views:MonitorPageBase>
