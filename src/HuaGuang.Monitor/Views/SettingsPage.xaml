<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HuaGuang.Monitor.ViewModels"
             x:Class="HuaGuang.Monitor.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Shell.NavBarIsVisible="False"
             SafeAreaEdges="All"
             BackgroundColor="#0B1522">

    <ScrollView>
        <VerticalStackLayout Padding="16,6,16,24" Spacing="14">
            <Label Text="采集" TextColor="White" FontSize="18" FontAttributes="Bold" />
            <Border IsVisible="{Binding HasInstanceBanner}"
                    Stroke="#2EC4B6"
                    StrokeThickness="1"
                    BackgroundColor="#122433"
                    Padding="12,10"
                    StrokeShape="RoundRectangle 8">
                <Label Text="{Binding InstanceBanner}"
                       TextColor="#2EC4B6"
                       FontSize="13"
                       LineBreakMode="WordWrap" />
            </Border>
            <Label Text="{Binding OccupancyWarning}"
                   TextColor="#FF6B6B"
                   FontSize="13"
                   LineBreakMode="WordWrap"
                   IsVisible="{Binding HasOccupancyWarning}" />
            <Label Text="运行模式" TextColor="#8AA0B5" FontSize="12" />
            <Picker ItemsSource="{Binding OperationModes}" SelectedItem="{Binding SelectedOperationMode}" />
            <Label Text="采集模式：读 PLC 并发布 MQTT。订阅模式：一个窗口可同时订阅多个主题，查看多条产线。"
                   TextColor="#8AA0B5" FontSize="12" LineBreakMode="WordWrap" />
            <Label Text="订阅主题（支持 + / #，可添加多个）" TextColor="#8AA0B5" FontSize="12" IsVisible="{Binding IsSubscribeSettings}" />
            <CollectionView ItemsSource="{Binding SubscribeTopics}" IsVisible="{Binding IsSubscribeSettings}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                            <Label Text="{Binding .}" TextColor="White" FontSize="14" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                            <Button Grid.Column="1"
                                    Text="删除"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, Path=RemoveSubscribeTopicCommand}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="#3A1F1F"
                                    TextColor="#FF6B6B"
                                    Padding="12,6" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="尚未添加订阅主题，请在下框输入后点「添加」。" TextColor="#8AA0B5" FontSize="12" />
                </CollectionView.EmptyView>
            </CollectionView>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding IsSubscribeSettings}">
                <Entry Text="{Binding NewSubscribeTopic}" Placeholder="monitor/+/telemetry" />
                <Button Grid.Column="1" Text="添加" Command="{Binding AddSubscribeTopicCommand}" />
            </Grid>
            <Label Text="首页可切换「全部」或单个主题查看设备；运行中也可在首页直接添加主题。"
                   TextColor="#8AA0B5" FontSize="12" LineBreakMode="WordWrap" IsVisible="{Binding IsSubscribeSettings}" />
            <Label Text="产线（采集：一条产线一个窗口，不可重复占用；订阅：只用该 Excel 的 Broker，主题可覆盖多条产线）" TextColor="#8AA0B5" FontSize="12" />
            <Picker ItemsSource="{Binding LineNames}"
                    SelectedItem="{Binding SelectedLineName}"
                    IsEnabled="{Binding CanChangeLinePicker}" />
            <HorizontalStackLayout Spacing="8" IsVisible="{Binding IsAcquisitionSettings}">
                <ActivityIndicator IsRunning="{Binding IsSwitchingLine}" IsVisible="{Binding IsSwitchingLine}" Color="#2EC4B6" />
                <Label Text="{Binding StatusMessage}"
                       TextColor="#8AA0B5"
                       FontSize="12"
                       LineBreakMode="WordWrap"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Label Text="{Binding LineExcelPath}" TextColor="#6E8499" FontSize="11" LineBreakMode="WordWrap" />
            <Button Text="从 Excel 载入产线" Command="{Binding LoadLineFromExcelCommand}" IsVisible="{Binding IsAcquisitionSettings}" />
            <Button Text="保存当前配置到 Excel" Command="{Binding SaveLineToExcelCommand}" BackgroundColor="#1F3A52" IsVisible="{Binding IsAcquisitionSettings}" />
            <Button Text="从其他 Excel 文件导入…" Command="{Binding ImportLineExcelFromFileCommand}" BackgroundColor="#1F3A52" IsVisible="{Binding IsAcquisitionSettings}" />
            <Label Text="全部配置保存在 lines 目录下对应产线 xlsx（与仓库 config/lines 同源）；点表仅以此 Excel 为准，不会自动追加代码内置点位。"
                   TextColor="#8AA0B5" FontSize="12" LineBreakMode="WordWrap" IsVisible="{Binding IsAcquisitionSettings}" />
            <Label Text="设备编号" TextColor="#8AA0B5" FontSize="12" IsVisible="{Binding IsAcquisitionSettings}" />
            <Entry Text="{Binding DeviceId}" Placeholder="LINE-01" IsVisible="{Binding IsAcquisitionSettings}" />
            <Label Text="PLC 采集周期（毫秒，2000 = 2 秒）" TextColor="#8AA0B5" FontSize="12" IsVisible="{Binding IsAcquisitionSettings}" />
            <Entry Text="{Binding ScanIntervalMs}" Keyboard="Numeric" IsVisible="{Binding IsAcquisitionSettings}" />
            <Label Text="两次 PLC 读取开始之间的间隔；仅控制本地采集与界面刷新，与 MQTT 发布无关。"
                   TextColor="#8AA0B5" FontSize="12" LineBreakMode="WordWrap" IsVisible="{Binding IsAcquisitionSettings}" />
            <Label Text="MQTT 发布周期（毫秒）" TextColor="#8AA0B5" FontSize="12" IsVisible="{Binding IsAcquisitionSettings}" />
            <Entry Text="{Binding PublishIntervalMs}" Keyboard="Numeric" IsVisible="{Binding IsAcquisitionSettings}" />
            <Label Text="两次 MQTT 上报之间的最短间隔；可与采集周期不同（例如 5 秒采 PLC、60 秒发 MQTT）。"
                   TextColor="#8AA0B5" FontSize="12" LineBreakMode="WordWrap" IsVisible="{Binding IsAcquisitionSettings}" />
            <Label Text="温度发布阈值（℃）" TextColor="#8AA0B5" FontSize="12" IsVisible="{Binding IsAcquisitionSettings}" />
            <Entry Text="{Binding TemperaturePublishThresholdC}" Keyboard="Numeric" Placeholder="0" IsVisible="{Binding IsAcquisitionSettings}" />
            <Label Text="0 = 仅按发布周期上报；大于 0 时，温度变化达到阈值也会提前触发发布。"
                   TextColor="#8AA0B5" FontSize="12" LineBreakMode="WordWrap" IsVisible="{Binding IsAcquisitionSettings}" />
            <Label Text="精度（小数位）" TextColor="#8AA0B5" FontSize="12" />
            <Entry Text="{Binding TemperaturePrecision}" Keyboard="Numeric" Placeholder="2" />
            <Label Text="全局默认显示与 MQTT 小数位（0–4）。各点位可在「点位 → 编辑」单独设置；未设置时使用此值。"
                   TextColor="#8AA0B5" FontSize="12" LineBreakMode="WordWrap" />
            <HorizontalStackLayout Spacing="10" IsVisible="{Binding IsAcquisitionSettings}">
                <CheckBox IsChecked="{Binding UseSimulator}" Color="#2EC4B6" VerticalOptions="Center" />
                <Label Text="使用模拟数据（无 PLC 时先勾选，可验证 MQTT）" TextColor="White" VerticalOptions="Center" LineBreakMode="WordWrap" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="10" IsVisible="{Binding StartupSupported}">
                <CheckBox IsChecked="{Binding StartWithWindows}" Color="#2EC4B6" VerticalOptions="Center" />
                <Label Text="{Binding StartWithWindowsLabel}" TextColor="White" VerticalOptions="Center" LineBreakMode="WordWrap" />
            </HorizontalStackLayout>
            <Label Text="快捷方式" TextColor="White" FontSize="18" FontAttributes="Bold" Margin="0,8,0,0" IsVisible="{Binding ShortcutsSupported}" />
            <Label Text="安装时不会自动创建。点「添加」写入桌面和开始菜单「工业监控」分组；「删除」只去掉这两处。"
                   TextColor="#8AA0B5"
                   FontSize="12"
                   LineBreakMode="WordWrap"
                   IsVisible="{Binding ShortcutsSupported}" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding ShortcutItems}"
                                 Spacing="8"
                                 IsVisible="{Binding ShortcutsSupported}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:DesktopShortcutItemViewModel">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding DisplayName}" TextColor="White" FontSize="14" />
                                <Label Text="{Binding StatusText}" TextColor="#8AA0B5" FontSize="12" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="添加"
                                    Command="{Binding AddCommand}"
                                    Padding="12,6" />
                            <Button Grid.Column="2"
                                    Text="删除"
                                    Command="{Binding RemoveCommand}"
                                    BackgroundColor="#3A1F1F"
                                    TextColor="#FF6B6B"
                                    Padding="12,6" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <HorizontalStackLayout Spacing="10">
                <CheckBox IsChecked="{Binding AutoStartAcquisition}" Color="#2EC4B6" VerticalOptions="Center" />
                <Label Text="启动后自动运行（采集或订阅，取决于运行模式）" TextColor="White" VerticalOptions="Center" LineBreakMode="WordWrap" />
            </HorizontalStackLayout>
            <Label Text="历史数据" TextColor="White" FontSize="18" FontAttributes="Bold" Margin="0,8,0,0" />
            <HorizontalStackLayout Spacing="10">
                <CheckBox IsChecked="{Binding EnableHistoryRecording}" Color="#2EC4B6" VerticalOptions="Center" />
                <Label Text="记录采集/订阅数据到本地 SQLite" TextColor="White" VerticalOptions="Center" LineBreakMode="WordWrap" />
            </HorizontalStackLayout>
            <Label Text="保留天数（1–365）" TextColor="#8AA0B5" FontSize="12" />
            <Entry Text="{Binding HistoryRetentionDays}" Keyboard="Numeric" Placeholder="1" />
            <Label Text="超出保留期的历史记录会在启动时自动清理。" TextColor="#8AA0B5" FontSize="12" LineBreakMode="WordWrap" />
            <Label Text="历史数据保存目录" TextColor="#8AA0B5" FontSize="12" />
            <Entry Text="{Binding HistoryDirectory}" Placeholder="留空则使用程序数据目录" />
            <Label Text="{Binding HistoryDirectoryHint}" TextColor="#6E8499" FontSize="11" LineBreakMode="WordWrap" />
            <Button Text="选择历史保存目录…" Command="{Binding PickHistoryDirectoryCommand}" BackgroundColor="#1F3A52" />

            <Label Text="诊断与日志" TextColor="White" FontSize="18" FontAttributes="Bold" Margin="0,8,0,0" />
            <Label Text="日志打包输出目录" TextColor="#8AA0B5" FontSize="12" />
            <Entry Text="{Binding LogExportDirectory}" Placeholder="点右侧按钮选择目录（含 USB）" />
            <Label Text="{Binding LogExportDirectoryHint}" TextColor="#6E8499" FontSize="11" LineBreakMode="WordWrap" />
            <Button Text="选择日志输出目录…" Command="{Binding PickLogExportDirectoryCommand}" BackgroundColor="#1F3A52" />
            <Label Text="诊断页「打包发送日志」会先弹出目录选择（Android 左侧可选 USB/SD 卡），再写入 zip。选好后请保存设置。"
                   TextColor="#8AA0B5" FontSize="12" LineBreakMode="WordWrap" />

            <Label Text="{Binding PlcSectionTitle}" TextColor="White" FontSize="18" FontAttributes="Bold" Margin="0,8,0,0" IsVisible="{Binding IsAcquisitionSettings}" />
            <Label Text="同一产线可连多台 PLC，协议可以不同（例如一台信捷 Modbus、一台西门子 S7）。点位编辑时选择所属 PLC。"
                   TextColor="#8AA0B5" FontSize="12" LineBreakMode="WordWrap" IsVisible="{Binding IsAcquisitionSettings}" />
            <Button Text="添加 PLC"
                    Command="{Binding AddPlcEndpointCommand}"
                    BackgroundColor="#1A2940"
                    TextColor="#2EC4B6"
                    Padding="12,8"
                    IsVisible="{Binding IsAcquisitionSettings}" />
            <CollectionView ItemsSource="{Binding PlcEndpoints}" IsVisible="{Binding IsAcquisitionSettings}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlcEndpointViewModel">
                        <Border Stroke="#243447" StrokeThickness="1" BackgroundColor="#111C2B" Padding="12" Margin="0,0,0,10">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Entry Text="{Binding Name}" Placeholder="PLC 名称" TextColor="White" />
                                    <Button Grid.Column="1"
                                            Text="删除"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, Path=RemovePlcEndpointCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#3A1F1F"
                                            TextColor="#FF6B6B"
                                            Padding="12,6" />
                                </Grid>
                                <HorizontalStackLayout Spacing="10">
                                    <CheckBox IsChecked="{Binding Enabled}" Color="#2EC4B6" VerticalOptions="Center" />
                                    <Label Text="启用" TextColor="White" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label Text="协议" TextColor="#8AA0B5" FontSize="12" />
                                <Picker ItemsSource="{Binding ProtocolOptions}" SelectedItem="{Binding SelectedProtocol}" />
                                <Label Text="型号（备注）" TextColor="#8AA0B5" FontSize="12" />
                                <Entry Text="{Binding Model}" Placeholder="XD5E-60T10 / S7-1200" />
                                <Label Text="IP 地址" TextColor="#8AA0B5" FontSize="12" />
                                <Entry Text="{Binding Host}" Placeholder="192.168.6.10" />
                                <Label Text="端口（Modbus 502 / S7 102）" TextColor="#8AA0B5" FontSize="12" />
                                <Entry Text="{Binding Port}" Keyboard="Numeric" />
                                <Label Text="站号（Modbus）" TextColor="#8AA0B5" FontSize="12" IsVisible="{Binding IsModbusPlc}" />
                                <Entry Text="{Binding Station}" Keyboard="Numeric" IsVisible="{Binding IsModbusPlc}" />
                                <Label Text="机架号（S7 Rack）" TextColor="#8AA0B5" FontSize="12" IsVisible="{Binding IsS7Plc}" />
                                <Entry Text="{Binding Rack}" Keyboard="Numeric" IsVisible="{Binding IsS7Plc}" />
                                <Label Text="槽位（S7 Slot）" TextColor="#8AA0B5" FontSize="12" IsVisible="{Binding IsS7Plc}" />
                                <Entry Text="{Binding Slot}" Keyboard="Numeric" IsVisible="{Binding IsS7Plc}" />
                                <Label Text="CPU 类型" TextColor="#8AA0B5" FontSize="12" IsVisible="{Binding IsS7Plc}" />
                                <Picker ItemsSource="{Binding S7CpuTypeOptions}" SelectedItem="{Binding CpuType}" IsVisible="{Binding IsS7Plc}" />
                                <Label Text="超时（毫秒）" TextColor="#8AA0B5" FontSize="12" />
                                <Entry Text="{Binding TimeoutMs}" Keyboard="Numeric" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="MQTT 采集发布" TextColor="White" FontSize="18" FontAttributes="Bold" Margin="0,8,0,0" />
            <Label Text="采集模式向所有已启用目标发布。账号与下方「订阅账号」分开，权限不同。"
                   TextColor="#8AA0B5" FontSize="12" LineBreakMode="WordWrap" />
            <Button Text="添加 MQTT 目标"
                    Command="{Binding AddMqttEndpointCommand}"
                    BackgroundColor="#1A2940"
                    TextColor="#2EC4B6"
                    Padding="12,8" />
            <CollectionView ItemsSource="{Binding MqttEndpoints}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:MqttEndpointViewModel">
                        <Border Stroke="#243447" StrokeThickness="1" BackgroundColor="#111C2B" Padding="12" Margin="0,0,0,10">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Entry Text="{Binding Name}" Placeholder="目标名称" TextColor="White" />
                                    <Button Grid.Column="1"
                                            Text="删除"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, Path=RemoveMqttEndpointCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#3A1F1F"
                                            TextColor="#FF6B6B"
                                            Padding="12,6" />
                                </Grid>
                                <HorizontalStackLayout Spacing="10">
                                    <CheckBox IsChecked="{Binding Enabled}" Color="#2EC4B6" VerticalOptions="Center" />
                                    <Label Text="启用" TextColor="White" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label Text="Broker 地址" TextColor="#8AA0B5" FontSize="12" />
                                <Entry Text="{Binding Host}" Placeholder="127.0.0.1" />
                                <Label Text="端口（默认 1888）" TextColor="#8AA0B5" FontSize="12" />
                                <Entry Text="{Binding Port}" Keyboard="Numeric" />
                                <Label Text="ClientId" TextColor="#8AA0B5" FontSize="12" />
                                <Entry Text="{Binding ClientId}" Placeholder="XHRRJFHJ" />
                                <Label Text="用户名" TextColor="#8AA0B5" FontSize="12" />
                                <Entry Text="{Binding Username}" />
                                <Label Text="密码" TextColor="#8AA0B5" FontSize="12" />
                                <Entry Text="{Binding Password}" IsPassword="True" />
                                <Label Text="发布主题，可用 {deviceId}" TextColor="#8AA0B5" FontSize="12" />
                                <Entry Text="{Binding Topic}" />
                                <Label Text="QoS（0 / 1 / 2）" TextColor="#8AA0B5" FontSize="12" />
                                <Entry Text="{Binding Qos}" Keyboard="Numeric" />
                                <HorizontalStackLayout Spacing="10">
                                    <CheckBox IsChecked="{Binding UseTls}" Color="#2EC4B6" VerticalOptions="Center" />
                                    <Label Text="启用 TLS" TextColor="White" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="MQTT 订阅账号" TextColor="White" FontSize="18" FontAttributes="Bold" Margin="0,8,0,0" />
            <Label Text="订阅大屏只用这一套账号连接 Broker（可只读订阅），不要填采集发布账号。"
                   TextColor="#8AA0B5" FontSize="12" LineBreakMode="WordWrap" />
            <Border Stroke="#243447" StrokeThickness="1" BackgroundColor="#111C2B" Padding="12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Broker 地址" TextColor="#8AA0B5" FontSize="12" />
                    <Entry Text="{Binding SubscribeMqtt.Host}" Placeholder="127.0.0.1" />
                    <Label Text="端口（默认 1888）" TextColor="#8AA0B5" FontSize="12" />
                    <Entry Text="{Binding SubscribeMqtt.Port}" Keyboard="Numeric" />
                    <Label Text="ClientId" TextColor="#8AA0B5" FontSize="12" />
                    <Entry Text="{Binding SubscribeMqtt.ClientId}" Placeholder="HG_SUB" />
                    <Label Text="用户名" TextColor="#8AA0B5" FontSize="12" />
                    <Entry Text="{Binding SubscribeMqtt.Username}" />
                    <Label Text="密码" TextColor="#8AA0B5" FontSize="12" />
                    <Entry Text="{Binding SubscribeMqtt.Password}" IsPassword="True" />
                    <Label Text="QoS（0 / 1 / 2）" TextColor="#8AA0B5" FontSize="12" />
                    <Entry Text="{Binding SubscribeMqtt.Qos}" Keyboard="Numeric" />
                    <HorizontalStackLayout Spacing="10">
                        <CheckBox IsChecked="{Binding SubscribeMqtt.UseTls}" Color="#2EC4B6" VerticalOptions="Center" />
                        <Label Text="启用 TLS" TextColor="White" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Button Text="{Binding SaveButtonText}" Command="{Binding SaveCommand}" />
            <Label Text="{Binding StatusMessage}"
                   TextColor="#2EC4B6"
                   FontSize="13"
                   LineBreakMode="WordWrap"
                   HorizontalOptions="Fill"
                   HorizontalTextAlignment="Start" />
            <Label Text="默认点表含胶辊型号、胶水型号、产品货号、门幅、厚度（手动输入）。华迪无“上展开转速率”。REAL 按 D 双字、CDAB 读取。"
                   TextColor="#8AA0B5" FontSize="12" LineBreakMode="WordWrap" IsVisible="{Binding IsAcquisitionSettings}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
