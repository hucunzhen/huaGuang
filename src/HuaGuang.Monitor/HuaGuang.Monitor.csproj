<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>HuaGuang.Monitor</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>工业监控</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.industrial.monitor</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.1</ApplicationDisplayVersion>
		<ApplicationVersion>2</ApplicationVersion>

		<!-- 解包运行，方便 Win10 工控机直接拷贝 exe，不必走 Microsoft Store。 -->
		<WindowsPackageType>None</WindowsPackageType>

		<!-- Android 11 = API 30；最低 24 可安装到 Android 11 工业平板，并避免 API 21–23 的 desugar 崩溃。 -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<!-- Windows 10 1809 (17763) 起，含 Win10 21H2/22H2 与 Win11。 -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
		<!-- Windows 解包 exe 图标（MauiIcon 不会写入 exe，需 ApplicationIcon） -->
		<ApplicationIcon>Resources\AppIcon\appicon.ico</ApplicationIcon>
	</PropertyGroup>

	<Target Name="SyncAppIconPng" BeforeTargets="PrepareForBuild">
		<Copy SourceFiles="$(MSBuildProjectDirectory)\Resources\AppIcon\logo.png"
		      DestinationFiles="$(MSBuildProjectDirectory)\Resources\AppIcon\appicon.png"
		      SkipUnchangedFiles="true"
		      Condition="Exists('$(MSBuildProjectDirectory)\Resources\AppIcon\logo.png')" />
	</Target>

	<Target Name="PrepareAppIcon" BeforeTargets="PrepareForBuild" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\generate-appicon-ico.ps1&quot;"
		      ConsoleToMSBuild="true"
		      Condition="Exists('$(MSBuildProjectDirectory)\..\..\scripts\generate-appicon-ico.ps1')" />
	</Target>

	<!-- Debug 不绑 RID / 自包含，否则 VS 附加不到 CoreCLR，会报“未引发 CoreCLR 启动事件”。 -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(Configuration)' == 'Debug'">
		<WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
		<SelfContained>false</SelfContained>
		<DebugType>portable</DebugType>
		<DebugSymbols>true</DebugSymbols>
	</PropertyGroup>

	<!-- Release / 现场发布：Win10 x64 自包含，并带上 Windows App SDK。 -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(Configuration)' == 'Release'">
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<SelfContained>true</SelfContained>
		<RuntimeIdentifierOverride>win-x64</RuntimeIdentifierOverride>
		<PublishSingleFile>false</PublishSingleFile>
	</PropertyGroup>

	<!-- Android 调试关掉 Fast Deployment，真机（含 Android 11）更容易被调试器挂上。 -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(Configuration)' == 'Debug'">
		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
	</PropertyGroup>

	<!-- Android 发布同时打 32/64 位 ARM，适配工业平板；侧载用 APK 而不是 Play 商店的 AAB。 -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(Configuration)' == 'Release'">
		<RuntimeIdentifiers>android-arm;android-arm64</RuntimeIdentifiers>
		<AndroidPackageFormat>apk</AndroidPackageFormat>
		<!-- 侧载请安装 *-Signed.apk；启用 v1 兼容部分工业平板 ROM。 -->
		<AndroidSigningV1Scheme>true</AndroidSigningV1Scheme>
		<AndroidSigningV2Scheme>true</AndroidSigningV2Scheme>
		<AndroidSigningV3Scheme>true</AndroidSigningV3Scheme>
	</PropertyGroup>

	<!-- Android 自适应图标背景强制不透明；改为 legacy 透明 PNG。 -->
	<Target Name="FixAndroidTransparentAppIcon"
	        AfterTargets="ResizetizeImages"
	        Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<PropertyGroup>
			<_AndroidIconResRoot>$([System.IO.Path]::Combine('$(IntermediateOutputPath)', 'resizetizer', 'r'))</_AndroidIconResRoot>
		</PropertyGroup>
		<Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\fix-android-transparent-icon.ps1&quot; -SourcePng &quot;$(MSBuildProjectDirectory)\Resources\AppIcon\appicon.png&quot; -ResRoot &quot;$(_AndroidIconResRoot)&quot;"
		      ConsoleToMSBuild="true"
		      Condition="Exists('$(MSBuildProjectDirectory)\..\..\scripts\fix-android-transparent-icon.ps1')" />
	</Target>

	<ItemGroup>
		<!-- App Icon：文件名须为 appicon；Android 构建后脚本会替换为透明 legacy 图标 -->
		<MauiIcon Include="Resources\AppIcon\appicon.png" Color="#00000000" />

		<MauiSplashScreen Include="Resources\AppIcon\appicon.png" Color="#000000" BaseSize="256,256" />

		<MauiImage Include="Resources\Images\*" Condition="Exists('Resources\Images')" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />

		<!-- 产线 Excel：Android 打包用 ASCII 资源名（aapt 不支持中文文件名） -->
		<MauiAsset Include="..\..\config\lines\先河热熔胶复合机.xlsx"
		           Link="Resources\Raw\lines\xianhe.xlsx"
		           LogicalName="lines/xianhe.xlsx" />
		<MauiAsset Include="..\..\config\lines\华迪热熔胶复合机.xlsx"
		           Link="Resources\Raw\lines\huadi.xlsx"
		           LogicalName="lines/huadi.xlsx" />
		<Content Include="Resources\AppIcon\appicon.ico"
		          CopyToOutputDirectory="PreserveNewest"
		          CopyToPublishDirectory="Always"
		          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" />
		<Content Include="..\..\config\lines\*.xlsx"
		          Exclude="..\..\config\lines\~$*;..\..\config\lines\*.new.xlsx"
		          Link="lines\%(Filename)%(Extension)"
		          CopyToOutputDirectory="Always"
		          CopyToPublishDirectory="Always"
		          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\HuaGuang.Monitor.Core\HuaGuang.Monitor.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="HuaGuang.Monitor.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="MQTTnet" Version="5.2.0.1603" />
		<PackageReference Include="NModbus" Version="3.0.83" />
	</ItemGroup>

	<!-- Release 发布完成后自动调用 Inno Setup 生成安装包（需本机安装 ISCC） -->
	<Import Project="BuildInstaller.targets" Condition="$([MSBuild]::IsOSPlatform('windows'))" />

</Project>
